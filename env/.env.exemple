AUTHENTICATOR_DATABASE_URL=postgresql://${DATABASE_AUTHENTICATOR}:${DATABASE_AUTHENTICATOR_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}



##############################################
## Postgraphile CONFIGURATION               ##
##############################################

GRAPHILE_ENV=development


##############################################
## JWT CONFIGURATION                        ##
##############################################

