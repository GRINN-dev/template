##############################################
## DATABASE CONFIGURATION                   ##
##############################################

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bookclub
DATABASE_OWNER=${DATABASE_NAME}_owner
DATABASE_OWNER_PASSWORD=owner_password
DATABASE_VISITOR=${DATABASE_NAME}_visitor
DATABASE_AUTHENTICATOR=${DATABASE_NAME}_authenticator
DATABASE_AUTHENTICATOR_PASSWORD=authenticator_password

DATABASE_URL=postgresql://${DATABASE_OWNER}:${DATABASE_OWNER_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}
