{
  "name": "bookclub",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ./env/.env -- turbo --env-mode=loose dev",
    "init-db": "dotenv -e ./env/.env -- node --loader ts-node/esm ./scripts/init-db.ts",
    "gm": "dotenv -e ./env/.env -- pnpm --filter db gm",
    "lint": "dotenv -e ./env/.env -- turbo --env-mode=loose lint",
    "format": "dotenv -e ./env/.env -- turbo --env-mode=loose format",
    "mobile": "dotenv -e ./env/.env -- pnpm --filter mobile"
  },
  "devDependencies": {
    "@grinn/prettier-config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^7.4.4",
    "pg": "^8.13.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.3.3",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.14.2",
  "prettier": "@grinn/prettier-config"
}
