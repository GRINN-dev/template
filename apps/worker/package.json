{
  "name": "workers",
  "version": "1.0.0",
  "main": "dist/index.js",
  "license": "MIT",
  "scripts": {
    "build": "tsup-node src/index.ts",
    "dev": "tsup-node src/index.ts --watch --onSuccess \"node dist/index.js\"",
    "start": "node dist/index.js",
    "install-db-schema": "pnpm gw --schema-only"
  },
  "dependencies": {
    "@getbrevo/brevo": "2.2.0",
    "graphile-worker": "^0.16.6",
    "@react-email/components": "0.0.32",
    "handlebars": "^4.7.8",
    "puppeteer": "^24.0.0"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "@grinn/eslint-config": "workspace:*",
    "@grinn/prettier-config": "workspace:*",
    "@grinn/tsconfig": "workspace:*",
    "@grinn/transactional": "workspace:*"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@grinn/eslint-config/base"
    ]
  },
  "prettier": "@grinn/prettier-config"
}
