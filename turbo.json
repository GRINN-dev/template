{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "AUTHENTICATOR_DATABASE_URL",
    "REFRESH_TOKEN_SECRET",
    "ACCESS_TOKEN_SECRET",
    "SERVER_PORT",
    "PORT",
    "BUCKET_HOST",
    "BUCKET_KEY",
    "BUCKET_SECRET",
    "BUCKET_NAME",
    "SERVER_URL",
    "FILE_STORAGE"
  ],

  "ui": "tui",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "format": {},
    "clean": {
      "cache": false
    }
  }
}
